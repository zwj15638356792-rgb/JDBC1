<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace:命令空间。现在可以随便起名。
              后续需要和dao的名称一致。
-->
<mapper namespace="com.dao.UsersDao">
    <!--根据id查询语句
             #{id}:表示占位符？。  mybatis会自动给该占位符赋值。
        resultType:结果类型。[查询的结果映射为的类型]
    -->
    <select id="get_id" resultType="Users">
        select * from users where id=#{id}
    </select>
    <select id="get_all" resultType="Users">
        select * from users
    </select>
    <!--添加操作 id:唯一标识。区分不同的sql语句
          #{name}和#{age}必须包装和实体类一致.
    -->
    <insert id="insert">
        insert into users (NAME,age) values (#{name},#{age})
    </insert>

    <!--删除-->
    <delete id="delete">
        delete from users where id=#{id}
    </delete>

    <!--修改
         #{name} #{age} #{id}必须和实体类属性名一致
    -->
    <update id="update">
        update users set name=#{name},age=#{age} where id=#{id}
    </update>

</mapper>